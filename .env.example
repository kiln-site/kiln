# Settings for compose.yaml. The installer (https://kiln.site/install) asks
# for these itself. The Relay reads everything here, so any setting in
# docs/self-hosting.md can go here too.

# REQUIRED: Where people will open Kiln, such as https://kiln.example.com or
# http://203.0.113.10:3000.
KILN_URL=

# OPTIONAL: What serves Kiln over HTTPS: traefik (on ports 80 and 443),
# coolify (Coolify's proxy), or none.
# DEFAULT: traefik
KILN_PLATFORM_PROXY=

# OPTIONAL: Host port for SFTP. (KILN_RELAY_SFTP_PORT, from Kiln's old
# compose.yaml, has no effect here.)
# DEFAULT: 2022
KILN_SFTP_PORT=

# OPTIONAL: Where players connect to game servers.
# DEFAULT: the host in KILN_URL
KILN_RELAY_GAME_HOST=
