          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (instance, kiln_relay_name) (rate(relay_host_cpu_time_seconds_total{cpu_mode!=\"idle\",kiln_installation_id=~\"$installation\",kiln_relay_name=~\"$relay\"}[$__rate_interval])) / max by (instance, kiln_relay_name) (relay_host_cpu_cores{kiln_installation_id=~\"$installation\",kiln_relay_name=~\"$relay\"})",
          "legendFormat": "{{kiln_relay_name}}",
          "range": true
        }
      ],
      "description": "Share of the node's cores doing anything but idling."
