      "id": 12,
      "type": "timeseries",
      "title": "Node memory used",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 33
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "custom": {
            "fillOpacity": 8,
            "showPoints": "never",
            "lineWidth": 1,
            "spanNulls": 60000,
            "stacking": {
              "mode": "none"
            }
          },
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull", "max"]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "1 - max by (instance, kiln_relay_name) (relay_host_memory_available_bytes{kiln_installation_id=~\"$installation\",kiln_relay_name=~\"$relay\"}) / max by (instance, kiln_relay_name) (relay_host_memory_total_bytes{kiln_installation_id=~\"$installation\",kiln_relay_name=~\"$relay\"})",
          "legendFormat": "{{kiln_relay_name}}",
          "range": true
        }
      ],
      "description": "Share of the node's memory it can't give out without swapping."
    },
    {
