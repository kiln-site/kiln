# The development stack's settings (compose.dev.yaml): `pnpm dev:setup`
# copies this to .env and fills in the secrets. To run Kiln, use the
# installer or compose.yaml and .env.example instead.

# Database

# REQUIRED: MySQL hostname
DB_HOST=mysql

# OPTIONAL: MySQL TCP port;
# DEFAULT: 3306.
DB_PORT=

# REQUIRED: MySQL database name
DB_NAME=hearth

# REQUIRED: MySQL username with data access to DB_NAME.
DB_USERNAME=kiln

# REQUIRED: MySQL password for DB_USERNAME.
DB_PASSWORD=replace-with-a-strong-database-password

# REQUIRED: Separate recovery key for encrypted Kiln platform backups.
# Keep an offline copy; losing both Hearth and this key makes bundles unusable.
# Generate with: openssl rand -base64 48
KILN_PLATFORM_BACKUP_KEY=

# OPTIONAL: Maximum runtime for a backup before Relay cancels it, in minutes.
# DEFAULT: 60
KILN_BACKUP_TIMEOUT=60

# OPTIONAL: How long a database terminal keeps running after its last open
# page closes, in minutes. Sessions stay open while a page shows them.
# DEFAULT: 15
KILN_DATABASE_TERMINAL_IDLE_TIMEOUT_MINUTES=

# OPTIONAL: table prefix for Hearth and Better Auth tables.
# DEFAULT: kiln_
DB_TABLE_PREFIX=kiln_

# Cache

# OPTIONAL: Valkey or Redis hostname. The Compose stack defaults this to its
# bundled cache service. Leave empty for standalone Hearth without a cache.
CACHE_HOST=

# OPTIONAL: Valkey or Redis TCP port.
# DEFAULT: 6379.
CACHE_PORT=

# OPTIONAL: Valkey or Redis ACL username and password.
CACHE_USERNAME=
CACHE_PASSWORD=

# OPTIONAL: Redis database index from 0 through 15.
# DEFAULT: 0.
CACHE_DATABASE=

# OPTIONAL: Enable TLS for the cache connection.
# DEFAULT: false.
CACHE_TLS=

# Hearth Environment

# REQUIRED: Public URL of the Hearth Panel
KILN_URL=https://kiln.site

# OPTIONAL: Identifier shared by Hearth, its database, and its Relays.
# DEFAULT: generated on Hearth's first start and saved in its database; Hearth
# sends it to its Relays. A value set here wins and is saved, so the
# installation keeps it if the variable is later removed. Development tooling
# sets it automatically for updater isolation.
KILN_INSTALLATION_ID=

# OPTIONAL: environment mode - Options: prod | dev
# DEFAULT: prod
KILN_ENVIRONMENT=prod

# OPTIONAL (build time): source revision displayed in the panel footer. Common
# DEFAULT: detects common env vars - GITHUB_SHA, COMMIT_SHA, and SOURCE_COMMIT.
KILN_BUILD_SHA=

# OPTIONAL: Allow users to sign up for an account
# DEFAULT: false
KILN_ENABLE_SIGNUPS=false

# OPTIONAL Creates initial super user account (does nothing if users already exist)
# DEFAULT: none - Use the browser-based first-user flow.
KILN_SUPER_USER_EMAIL=
KILN_SUPER_USER_PASSWORD=

# Relay Initialization

# OPTIONAL: Prefix and ownership scope for Relay-created Docker resources.
# Leave empty for the legacy single-Relay layout. Development tooling assigns
# this automatically to linked worktrees.
KILN_RELAY_RESOURCE_NAMESPACE=

# OPTIONAL: Public Relay hostname advertised to Hearth and browsers. It may be
# a DNS name or IP address; TLS certificates must contain the same name.
KILN_RELAY_HOST=

# OPTIONAL: Hostname or IP advertised for game server ports. Leave empty to
# use the resolved KILN_RELAY_HOST. Set to public-ip to ignore both hostnames
# and discover the Relay's public IPv4 address at startup.
KILN_RELAY_GAME_HOST=

# OPTIONAL: Host ports assigned to newly created game servers. Forward and
# allow this range through the Relay host firewall/NAT.
# DEFAULT: 30000-39999
KILN_RELAY_GAME_PORT_RANGE=30000-39999

# OPTIONAL: Number of automatic restarts after an unexpected game-server exit.
# Set to 0 to disable automatic crash recovery.
# DEFAULT: 2
KILN_RELAY_CRASH_RETRY_LIMIT=2

# OPTIONAL: Delay before the first recovery attempt. Later attempts use a
# bounded exponential delay.
# DEFAULT: 5
KILN_RELAY_CRASH_RETRY_DELAY_SECONDS=5

# OPTIONAL: Healthy runtime required before Relay resets the retry budget.
# DEFAULT: 300
KILN_RELAY_CRASH_STABILITY_SECONDS=300

# OPTIONAL: Relay listener. Direct modes serve HTTPS/WSS; terminating proxy
# modes keep private HTTP/WS on this port. This does not need to be port 443.
# DEFAULT: 4100
KILN_RELAY_PORT=4100

# OPTIONAL: Loopback-only plain-HTTP port for the Relay image's Docker
# healthcheck. It only serves GET /health on 127.0.0.1 and is never published.
# DEFAULT: 4101
KILN_RELAY_HEALTH_PORT=4101

# OPTIONAL: Host address used by the supplied Compose file for Relay port 4100.
# Keep the loopback default with bundled Traefik or Coolify. A manual/direct
# deployment may deliberately set 0.0.0.0 after configuring trusted Relay TLS.
# DEFAULT: 127.0.0.1
KILN_RELAY_PUBLISH_ADDRESS=127.0.0.1

# OPTIONAL: Advertised port when a proxy maps a different external port.
# DEFAULT: KILN_RELAY_PORT
KILN_RELAY_PUBLIC_PORT=

# OPTIONAL: Public HTTPS origin used when an edge terminates TLS. Coolify mode
# discovers COOLIFY_URL, COOLIFY_FQDN, and generated SERVICE_URL_*_<port> values
# automatically; set this only to override an ambiguous generated value. In a
# combined Hearth/Relay stack, provide the same value to both services so the
# one-time environment bootstrap uses the public edge.
KILN_RELAY_PUBLIC_URL=

# OPTIONAL (Hearth): private Relay control endpoint for a shared Compose/network
# deployment. Remote Hearths should leave this empty and use the paired public
# WSS endpoint. Application signatures still authenticate the private WS hop.
KILN_RELAY_CONTROL_URL=

# OPTIONAL (Hearth): transfers Hearth carries at once, for all Relays it
# passes transfers through to (those browsers can't reach directly).
# DEFAULT: 64
KILN_RELAY_PASSTHROUGH_MAX=

# OPTIONAL (Hearth): bytes a second for all transfers Hearth carries
# together. Empty means no cap.
KILN_RELAY_PASSTHROUGH_BYTES_PER_SECOND=

# OPTIONAL: Browser edge mode, seeded only when Relay proxy state is empty.
# none leaves edge ownership entirely manual, hearth proxies Kiln traffic
# through Hearth, traefik lifecycle-manages a bundled kiln-traefik container,
# and coolify reuses Coolify's existing Traefik and public certificate.
# DEFAULT: none
KILN_RELAY_PROXY=none

# OPTIONAL: Browser-to-Relay admission ceilings. Total, instance, and identity
# session pools are enforced by default. A proxy peer/IP is not an authorization
# identity, so forwarded client IPs are never trusted by default.
KILN_RELAY_BROWSER_SESSIONS_MAX=512
KILN_RELAY_BROWSER_SESSIONS_PER_INSTANCE_MAX=256
KILN_RELAY_BROWSER_SESSIONS_PER_USER_MAX=64
KILN_RELAY_BROWSER_SESSIONS_PER_USER_INSTANCE_MAX=16
KILN_RELAY_BROWSER_PENDING_HANDSHAKES_MAX=64
KILN_RELAY_BROWSER_PENDING_HANDSHAKES_PER_IP_MAX=16
KILN_RELAY_BROWSER_PENDING_FILE_AUTH_MAX=16
KILN_RELAY_BROWSER_SUBLIMITS_ENFORCE=true

# OPTIONAL: Browser stream/replay memory ceilings.
KILN_RELAY_BROWSER_OUTBOX_MESSAGES_MAX=256
KILN_RELAY_BROWSER_OUTBOX_BYTES_MAX=2097152
KILN_RELAY_BROWSER_FILE_REPLAYS_MAX=65536

# OPTIONAL (Hearth): Minimum accepted browser capability version by operation
# kind. Keep these at 1 during rolling deployment. Raise a kind to 2 only after
# its Relay and browser renewal/replay paths are deployed and v1-use telemetry
# is near zero; a minimum of 2 fails closed instead of silently downgrading.
KILN_BROWSER_CAPABILITY_CONSOLE_MIN_VERSION=1
KILN_BROWSER_CAPABILITY_RESOURCES_MIN_VERSION=1
KILN_BROWSER_CAPABILITY_FILE_MIN_VERSION=1

# OPTIONAL: Official pinned image used only by bundled Traefik mode. This can
# also be changed later from Hearth's Relay settings.
KILN_RELAY_TRAEFIK_IMAGE=traefik:v3.7.13

# OPTIONAL but recommended for Let's Encrypt expiry and account notices.
KILN_RELAY_ACME_EMAIL=

# OPTIONAL: When KILN_RELAY_HOST is empty, attempt a two-second public DNS
# lookup before falling back to the container/host name. Disable for privacy or
# when the Relay must only advertise an internal address.
# DEFAULT: true
KILN_RELAY_DISCOVER_PUBLIC_IP=true

# OPTIONAL: Relay SFTP listener.
# DEFAULT: 2022
KILN_RELAY_SFTP_PORT=2022

# OPTIONAL: Seeds the Relay-owned name only when /data is empty.
# Custom seeds are truncated to 13 characters. Hearth increments default names
# from K100 as additional Relays are paired.
# DEFAULT: K100
KILN_RELAY_NAME=

# OPTIONAL: managed creates a Relay-local CA and renewable leaf certificate;
# external loads KILN_RELAY_TLS_CERT_FILE and KILN_RELAY_TLS_KEY_FILE.
# Development mode is rejected when NODE_ENV=production.
# DEFAULT: managed in production, development otherwise
KILN_RELAY_TLS_MODE=managed
KILN_RELAY_TLS_CERT_FILE=
KILN_RELAY_TLS_KEY_FILE=

# OPTIONAL: one-time initial pairing value shared by Relay and Hearth in a
# colocated Compose deployment. It is ignored after durable pairing succeeds.
# Generate with: openssl rand -base64 48
KILN_RELAY_BOOTSTRAP_TOKEN=
KILN_RELAY_BOOTSTRAP_TOKEN_FILE=

# OPTIONAL: GitHub repository used for releases, source links, and the default
# Brick catalog. Accepts owner/repository or a full GitHub URL.
# DEFAULT: https://github.com/kiln-site/kiln
KILN_GIT_REPO=

# OPTIONAL: Compose image namespace and channel. Download distribution.env from
# your fork's release to set the prefix automatically. Exact version pins disable
# in-panel updates; latest and latest-nightly remain managed channels.
KILN_IMAGE_PREFIX=ghcr.io/kiln-site
KILN_IMAGE_TAG=latest

# OPTIONAL: Hearth-owned default Brick catalog. HTTPS is required unless an
# operator explicitly configures a local file: URL for an air-gapped install.
# DEFAULT: apps/bricks/catalog.yml from KILN_GIT_REPO
KILN_BRICKS_CATALOG_URL=

# OPTIONAL: a website whose /terms and /privacy pages the panel footer's Terms
# of Use and Privacy Policy links open.
# DEFAULT: https://kiln.site with Kiln's official images. With a fork's images,
# kiln.site/forks-legal, which says Kiln doesn't run the panel and points
# visitors to whoever does.
KILN_MARKETING_URL=

# Better Auth

# REQUIRED: Versioned secrets for authentication and Relay credentials
# Generate with: openssl rand -base64 48
# Docs: https://better-auth.com/docs/reference/options#secrets
BETTER_AUTH_SECRETS=1:

# OPTIONAL: Additional trusted browser origins, comma-separated
# DEFAULT: KILN_URL and Kiln's local development origins
BETTER_AUTH_TRUSTED_ORIGINS=

# Resend

# OPTIONAL: Resend credentials for authentication and invitation emails
# DEFAULT: none - New accounts skip email verification; recovery codes and invitation links are written to logs
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# mclogs

# OPTIONAL: mclo.gs upload API
# DEFAULT: https://api.mclo.gs/1/log
MCLOGS_API_URL=

# Telemetry (OpenTelemetry)

# OPTIONAL: Sends traces, logs and metrics to any OTLP/HTTP backend, such as
# Grafana (Tempo, Loki, Prometheus). Published images bake in
# defaults for these; set a variable here to override its default.
# Header values are URI-encoded: write a space as %20 and "=" as %3D.
# DEFAULT: the published image's defaults; none for custom builds
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=

# OPTIONAL: Signals to export once an endpoint is set: otlp or none.
# DEFAULT: the published image's defaults, else otlp for traces and logs and
# none for metrics
OTEL_TRACES_EXPORTER=
OTEL_LOGS_EXPORTER=
OTEL_METRICS_EXPORTER=

# OPTIONAL: Fraction of traces kept (0–1).
# DEFAULT: 0.05
OTEL_TRACES_SAMPLER_ARG=

# OPTIONAL: Extra resource attributes, e.g. deployment.environment.name=production
OTEL_RESOURCE_ATTRIBUTES=

# OPTIONAL: true turns telemetry off entirely, including baked defaults.
# DEFAULT: false
OTEL_SDK_DISABLED=
