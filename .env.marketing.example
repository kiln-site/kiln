# Marketing app runtime configuration. For local development, put these in
# the workspace root .env; for the published image, set container environment
# variables. All values here are public.
KILN_HEARTH_URL=https://panel.kiln.site
KILN_DOCS_URL=https://docs.kiln.site
KILN_SITE_URL=https://kiln.site

# OPTIONAL: Umami tracking. Set both values to enable it. Use the full script
# URL, including your custom TRACKER_SCRIPT_NAME if configured in Umami.
# KILN_WEB_ANALYTICS_URL=https://stats.example.com/script.js
# KILN_WEB_ANALYTICS_WEBSITE_ID=your-umami-website-id
