{
  "name": "kiln-cli",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "bin": {
    "kiln": "dist/kiln"
  },
  "scripts": {
    "build": "bun scripts/build.mjs",
    "build:npm": "bun scripts/build.mjs --npm-only",
    "dev": "bun src/main.ts",
    "format": "vp fmt \"src/**/*.ts\"",
    "lint": "vp lint src",
    "test": "vp test run",
    "test:credential-store": "pnpm build && node scripts/credential-store-e2e.mjs"
  },
  "dependencies": {
    "@workspace/contracts": "workspace:*",
    "effect": "4.0.0-rc.118",
    "ssh2": "1.17.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0-rc.118",
    "@types/node": "^22",
    "@types/ssh2": "1.15.5",
    "bun": "1.2.18",
    "typescript": "^6",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=20"
  }
}
