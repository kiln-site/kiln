    "@tanstack/react-virtual": "^3.14.6",
    "@workspace/contracts": "workspace:*",
    "@workspace/ui": "workspace:*",
    "better-auth": "^1.6.23",
    "codemirror": "^6.0.2",
    "cronstrue": "^3.24.0",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "effect": "4.0.0-beta.99",
    "ioredis": "^5.11.1",
    "lucide-react": "^1.24.0",
    "motion": "^12.42.2",
    "mysql2": "^3.22.6",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-qr-code": "^2.2.0",
    "resend": "^6.17.2",
    "srvx": "^0.11.16",
    "tldts": "^7.4.10",
    "ws": "8.21.1",
