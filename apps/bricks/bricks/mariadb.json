{
  "$schema": "https://kiln.site/bricks/schema.json",
  "format": "kiln.brick/v2",
  "id": "mariadb",
  "name": "MariaDB",
  "kind": "database",
  "summary": "Community-developed MySQL fork with drop-in compatibility.",
  "author": "Kiln",
  "icon": "../icons/mariadb.svg",
  "color": "#c49528",
  "tags": ["sql", "relational"],
  "platforms": ["amd64", "arm64"],
  "links": {
    "homepage": "https://mariadb.org",
    "docs": "https://mariadb.com/kb/en/documentation/"
  },
  "inputs": [
    {
      "key": "database",
      "label": "Database name",
      "type": "text",
      "help": "The database Kiln creates on first start.",
      "default": "app",
      "pattern": "^[a-z][a-z0-9_]{0,47}$"
    },
    {
      "key": "username",
      "label": "Username",
      "type": "text",
      "help": "The user apps connect as.",
      "default": "kiln",
      "pattern": "^[a-z][a-z0-9_]{0,31}$"
    },
    {
      "key": "password",
      "label": "Password",
      "type": "secret",
      "help": "Leave it to Kiln to make a strong one.",
      "generate": true,
      "min": 24,
      "max": 256
    },
    {
      "key": "root_password",
      "label": "Root password",
      "type": "secret",
      "help": "Kiln uses it for backups.",
      "generate": true,
      "min": 24,
      "max": 256,
      "advanced": true
    }
  ],
  "deploy": {
    "type": "image",
    "image": "mariadb:11.8",
    "env": {
      "MARIADB_DATABASE": "{{ database }}",
      "MARIADB_USER": "{{ username }}",
      "MARIADB_PASSWORD": "{{ password }}",
      "MARIADB_ROOT_PASSWORD": "{{ root_password }}"
    },
    "ports": [
      {
        "name": "mysql",
        "port": 3306
      }
    ],
    "volumes": [
      {
        "path": "/var/lib/mysql"
      }
    ],
    "ready": {
      "type": "command",
      "command": "healthcheck.sh --connect --innodb_initialized"
    },
    "resources": {
      "memory": "1G"
    }
  },
  "database": {
    "engine": "mariadb",
    "language": "sql",
    "port": "mysql",
    "viewer": "mysql",
    "connection": "mysql://{{ username }}:{{ password }}@{{ kiln.host }}:3306/{{ database }}",
    "backup": {
      "command": "MYSQL_PWD=\"$MARIADB_ROOT_PASSWORD\" exec mariadb-dump --user=root --single-transaction --skip-lock-tables \"$MARIADB_DATABASE\"",
      "extension": "sql"
    },
    "restore": {
      "command": "MYSQL_PWD=\"$MARIADB_ROOT_PASSWORD\" exec mariadb --user=root \"$MARIADB_DATABASE\""
    }
  }
}
