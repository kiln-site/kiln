{
  "$schema": "https://kiln.site/bricks/schema.json",
  "format": "kiln.brick/v2",
  "id": "mysql",
  "name": "MySQL",
  "kind": "database",
  "summary": "The world's most deployed open-source SQL database.",
  "author": "Kiln",
  "icon": "../icons/mysql.svg",
  "color": "#4b98b0",
  "tags": ["sql", "relational"],
  "platforms": ["amd64", "arm64"],
  "links": {
    "homepage": "https://www.mysql.com",
    "docs": "https://dev.mysql.com/doc/refman/8.4/en/"
  },
  "inputs": [
    {
      "key": "database",
      "label": "Database name",
      "type": "text",
      "help": "The database Kiln creates on first start.",
      "default": "app",
      "pattern": "^[a-z][a-z0-9_]{0,47}$"
    },
    {
      "key": "username",
      "label": "Username",
      "type": "text",
      "help": "The user apps connect as.",
      "default": "kiln",
      "pattern": "^[a-z][a-z0-9_]{0,31}$"
    },
    {
      "key": "password",
      "label": "Password",
      "type": "secret",
      "help": "Leave it to Kiln to make a strong one.",
      "generate": true,
      "min": 24,
      "max": 256
    },
    {
      "key": "root_password",
      "label": "Root password",
      "type": "secret",
      "help": "Kiln uses it for backups.",
      "generate": true,
      "min": 24,
      "max": 256,
      "advanced": true
    }
  ],
  "deploy": {
    "type": "image",
    "image": "mysql:8.4",
    "env": {
      "MYSQL_DATABASE": "{{ database }}",
      "MYSQL_USER": "{{ username }}",
      "MYSQL_PASSWORD": "{{ password }}",
      "MYSQL_ROOT_PASSWORD": "{{ root_password }}"
    },
    "ports": [
      {
        "name": "mysql",
        "port": 3306
      }
    ],
    "volumes": [
      {
        "path": "/var/lib/mysql"
      }
    ],
    "ready": {
      "type": "command",
      "command": "mysqladmin ping -h 127.0.0.1 --silent"
    },
    "resources": {
      "memory": "1G"
    }
  },
  "database": {
    "engine": "mysql",
    "language": "sql",
    "port": "mysql",
    "viewer": "mysql",
    "connection": "mysql://{{ username }}:{{ password }}@{{ kiln.host }}:3306/{{ database }}",
    "backup": {
      "command": "MYSQL_PWD=\"$MYSQL_ROOT_PASSWORD\" exec mysqldump --user=root --single-transaction --skip-lock-tables --no-tablespaces \"$MYSQL_DATABASE\"",
      "extension": "sql"
    },
    "restore": {
      "command": "MYSQL_PWD=\"$MYSQL_ROOT_PASSWORD\" exec mysql --user=root \"$MYSQL_DATABASE\""
    }
  }
}
